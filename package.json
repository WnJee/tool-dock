{
  "name": "tool-dock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run test && vite build",
    "preview": "vite preview",
    "deploy:pages": "bash scripts/deploy-pages.sh"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "js-yaml": "^5.2.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sm-crypto": "^0.5.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.6",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "^4.112.0"
  }
}
